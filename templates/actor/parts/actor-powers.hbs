{{#each powers as |powers powerSet|}}
  {{#if powers}}
    <ol class="mm-item-list">
      <li class="flexrow item mm-item-header">
        <span>{{localize "MULTIVERSE_D616.Item.Power.PowerSET" set=powerSet}}</span>
        <hr />
        {{#if @root.editable}}
          <div class="item-controls">
            <a
              class="item-control item-create"
              title="{{localize 'DOCUMENT.Create' type="Power"}}"
              data-type="power"
              data-power-set="{{powerSet}}"
            >
              <i class="fas fa-plus"></i>
            </a>
          </div>
        {{else if @root.vehicleReadOnly}}
          <div class="item-controls m616-view-only-controls" aria-hidden="true"><span><i class="fas fa-plus"></i></span></div>
        {{/if}}
      </li>
      {{#each powers as |item id|}}
        <li class="flexrow item mm-item" data-item-id="{{item._id}}" >
          <div class="item-name mm-item-name">
            {{#if @root.editable}}
              <a class="rollable" data-roll-type="item" data-item-id="{{item._id}}">
                <span>{{item.name}}</span>
                {{#if item.system.cost }}
                  <span>Cost: {{item.system.cost}}</span>
                {{/if}}
              </a>
            {{else if @root.vehicleCanRoll}}
              <a class="rollable" data-roll-type="item" data-item-id="{{item._id}}">
                <span>{{item.name}}</span>
                {{#if item.system.cost }}<span>Cost: {{item.system.cost}}</span>{{/if}}
              </a>
            {{else}}
              <span>{{item.name}}</span>
              {{#if item.system.cost }}
                <span>Cost: {{item.system.cost}}</span>
              {{/if}}
            {{/if}}
          </div>
          {{#if @root.editable}}
            <div class="item-controls">
              <a
                class="item-control item-edit"
                title="{{localize 'DOCUMENT.Edit' type="power"}}"
              >
                <i class="fas fa-edit"></i>
              </a>
              <a
                class="item-control item-delete"
                title="{{localize 'DOCUMENT.Delete' type="power"}}"
              >
                <i class="fas fa-trash"></i>
              </a>
            </div>
          {{else if @root.vehicleReadOnly}}
            <div class="item-controls m616-view-only-controls" aria-hidden="true"><span><i class="fas fa-edit"></i></span><span><i class="fas fa-trash"></i></span></div>
          {{/if}}
        </li>
      {{/each}}
    </ol>
  {{/if}}
{{/each}}
