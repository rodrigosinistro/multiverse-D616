{{#each origins as |item id|}}
  <div class="item mm-input-item" data-item-id="{{item._id}}">
    <div class="item-name">
      {{#if @root.editable}}
        <a class="rollable" data-roll-type="item">
          <h4>
            <span>{{item.name}}</span>
            <a class="item-control item-delete" title="{{localize 'DOCUMENT.Delete' type='origin'}}">
              <i class="fas fa-trash"></i>
            </a>
          </h4>
        </a>
      {{else}}
        <h4><span>{{item.name}}</span></h4>
      {{/if}}
    </div>
  </div>
{{/each}}
