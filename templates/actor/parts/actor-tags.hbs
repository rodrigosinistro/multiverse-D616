<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Tags</span>
    <hr />
    {{#if @root.editable}}
      <div class="item-controls">
        <a
          class="item-control item-create"
          title="Create item"
          data-type="tag"
        >
          <i class="fas fa-plus"></i>
        </a>
      </div>
    {{/if}}
  </li>
  {{#each tags as |item id|}}
    <li class="flexrow item mm-item" data-item-id='{{item._id}}'>
      <div class="item-name mm-item-name">
        {{#if @root.editable}}
          <a class="rollable" data-roll-type="item">{{item.name}}</a>
        {{else}}
          <span>{{item.name}}</span>
        {{/if}}
      </div>
      {{#if @root.editable}}
        <div class="item-controls">
          <a
            class="item-control item-edit"
            title="{{localize 'DOCUMENT.Edit' type="tag"}}"
          >
            <i class="fas fa-edit"></i>
          </a>
          <a
            class="item-control item-delete"
            title="{{localize 'DOCUMENT.Delete' type="tag"}}"
          >
            <i class="fas fa-trash"></i>
          </a>
        </div>
      {{/if}}
    </li>
  {{/each}}
</ol>
