<form class="{{cssClass}} {{actor.type}} flexcol mm-limited-sheet" autocomplete="off">
  <header class="sheet-header" style="display:flex;flex-direction:column;align-items:center;gap:0.75rem;padding:1rem;">
    <div class="mm-limited-portrait" style="width:260px;max-width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:10px;">
      <img src="{{actor.img}}" title="{{actor.name}}" style="width:100%;height:100%;object-fit:cover;"/>
    </div>
    <h2 style="margin:0;">{{actor.name}}</h2>
  </header>
</form>
