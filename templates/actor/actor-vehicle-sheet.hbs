<form class="{{cssClass}} npc mm-v2-npc mm-v2-vehicle" autocomplete="off">
  <header class="mm-v2-npc-title">
    <div class="mm-styled-field">
      <label class="mm-styled-label -align-left" for="name"><span>Veículo</span></label>
      <div class="mm-styled-input"><input name="name" type="text" value="{{actor.name}}" placeholder="Codename"/></div>
    </div>
    <div class="mm-v2-npc-rank">
      <label for="system.attributes.rank.value">RANK</label>
      <input type="number" name="system.attributes.rank.value" value="{{system.attributes.rank.value}}" data-dtype="Number"/>
    </div>
  </header>

  <div class="mm-v2-npc-top">
    <section class="mm-v2-npc-identity mm-v2-card" aria-label="Retrato e recursos">
      <div class="mm-v2-npc-portrait">
        <img src="{{actor.img}}" {{#if editable}}data-edit="img"{{/if}} alt="{{actor.name}}" title="{{actor.name}}"/>
      </div>
      <div class="mm-v2-npc-resources">
        <div class="mm-v2-npc-resource">
          <div class="mm-v2-resource-heading">HEALTH <span>DR {{system.healthDamageReduction}}</span></div>
          <div class="mm-v2-numbers"><input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" aria-label="Health atual"/><span>/</span><output class="m616-vehicle-auto-max" aria-label="Health máximo calculado">{{system.health.max}}</output></div>
        </div>
        <div class="mm-v2-npc-resource -focus">
          <div class="mm-v2-resource-heading">FOCUS <span>DR {{system.focusDamageReduction}}</span></div>
          <div class="mm-v2-numbers"><input type="number" name="system.focus.value" value="{{system.focus.value}}" data-dtype="Number" aria-label="Focus atual"/><span>/</span><output class="m616-vehicle-auto-max" aria-label="Focus máximo calculado">{{system.focus.max}}</output></div>
        </div>
      </div>
    </section>

    <section class="mm-v2-card mm-v2-abilities" aria-label="Atributos">
      <h3>Abilities</h3>
      <div class="mm-v2-stat-head"><span>Ability</span><span>Score</span><span>Defense</span></div>
      {{#each system.abilities as |ability key|}}
      <div class="mm-v2-stat-row">
        <div class="mm-v2-stat-name {{#if @root.vehicleCanRoll}}rollable{{/if}}" {{#if @root.vehicleCanRoll}}data-formula="{1d6,1dm,1d6}+@abilities.{{key}}.value" data-label="{{ability.label}}"{{/if}}>
          {{#if (eq key "mle")}}Melee{{else if (eq key "agl")}}Agility{{else if (eq key "res")}}Resilience{{else if (eq key "vig")}}Vigilance{{else if (eq key "ego")}}Ego{{else if (eq key "log")}}Logic{{/if}}
        </div>
        <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" aria-label="Atributo {{key}}"/>
        <output>{{ability.defense}}</output>
      </div>
      {{/each}}
    </section>

    <div class="m616-vehicle-right-column">
    <section class="mm-v2-card mm-v2-damage" aria-label="Dano">
      <h3>Damage</h3>
      <div class="mm-v2-damage-head"><span>Ability</span><span>Multiplier</span><span>Bonus</span></div>
      <div class="mm-v2-damage-row"><span>Melee</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.mle.damageMultiplier}}</strong><output>+{{system.abilities.mle.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Agility</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.agl.damageMultiplier}}</strong><output>+{{system.abilities.agl.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Ego</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.ego.damageMultiplier}}</strong><output>+{{system.abilities.ego.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Logic</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.log.damageMultiplier}}</strong><output>+{{system.abilities.log.value}}</output></div>
    </section>
      <section class="mm-v2-card m616-vehicle-movement" aria-label="Movimento do veículo">
        <h3><i class="fas fa-gauge-high"></i> Movimento</h3>
        <div class="m616-vehicle-movement-head"><span>Modo</span><span>Combate</span><span>Fora de combate</span></div>
        {{#each system.movement as |speed key|}}
          {{#if speed.active}}
          <div class="m616-vehicle-movement-row" data-movement="{{key}}">
            <span>{{localize speed.label}}</span>
            <output>{{speed.value}}</output>
            <output>{{speed.noncom}}</output>
          </div>
          {{/if}}
        {{/each}}
        <small>Valores em espaços, conforme o movimento do veículo e seus poderes ativos.</small>
      </section>
    </div>
  </div>


  <div class="mm-v2-npc-bottom">
    <section class="mm-styled-container mm-powers-block">
      <h3>Powers</h3>
      <div class="mm-styled-container-body">{{> "systems/multiverse-d616/templates/actor/parts/actor-powers.hbs"}}</div>
    </section>
    <section class="mm-styled-container mm-traitstags-block">
      <h3>Traits &amp; Tags</h3>
      <div class="mm-styled-container-body">
        {{> "systems/multiverse-d616/templates/actor/parts/actor-traits.hbs"}}
        {{> "systems/multiverse-d616/templates/actor/parts/actor-tags.hbs"}}
      </div>
    </section>
  </div>

  <section class="m616-vehicle-crew mm-v2-card" aria-label="Tripulação">
    <div class="m616-vehicle-crew-head">
      <h3><i class="fas fa-users"></i> Tripulação</h3>
      {{#if vehicleInScene}}
      <span class="m616-vehicle-current-token"><i class="fas fa-location-dot"></i> {{vehicleTokenName}}</span>
      {{else}}
      <span class="m616-vehicle-warning">Selecione o token da nave nesta cena</span>
      {{/if}}
    </div>
    <div class="m616-vehicle-settings">
      <label for="m616-visibility">Visibilidade da tripulação</label>
      <select id="m616-visibility" class="m616-vehicle-visibility" {{#unless vehicleCanManage}}disabled{{/unless}}>
        <option value="hidden" {{#if (eq crewVisibility "hidden")}}selected{{/if}}>Oculta — apenas a nave aparece</option>
        <option value="visible" {{#if (eq crewVisibility "visible")}}selected{{/if}}>Visível — tripulantes sobre a nave</option>
      </select>
      <small>A configuração pertence ao veículo. Não altera as fichas dos tripulantes.</small>
    </div>
    <div class="m616-vehicle-crew-drop">
      <i class="fas fa-user-plus"></i>
      Arraste um personagem ou token aqui para embarcar
      <button type="button" class="m616-vehicle-add-selected" {{#unless vehicleCanManage}}disabled{{/unless}}><i class="fas fa-crosshairs"></i> Embarcar token selecionado</button>
    </div>
    <div class="m616-vehicle-crew-list">
      {{#each crew as |member|}}
      <div class="m616-vehicle-member" data-token-id="{{member.tokenId}}">
        <strong><i class="fas fa-user-astronaut"></i> {{member.name}}</strong>
        <select class="m616-vehicle-role" data-token-id="{{member.tokenId}}" {{#unless @root.vehicleCanManage}}disabled{{/unless}}>
          <option value="pilot" {{#if member.rolePilot}}selected{{/if}}>Piloto</option>
          <option value="copilot" {{#if member.roleCopilot}}selected{{/if}}>Copiloto</option>
          <option value="operator" {{#if member.roleOperator}}selected{{/if}}>Operador</option>
          <option value="passenger" {{#if member.rolePassenger}}selected{{/if}}>Passageiro</option>
        </select>
        <button class="m616-vehicle-disembark" data-token-id="{{member.tokenId}}" type="button" {{#unless @root.vehicleCanManage}}disabled{{/unless}}><i class="fas fa-person-walking-arrow-right"></i> Desembarcar</button>
      </div>
      {{else}}
      <p class="m616-vehicle-empty">Nenhum personagem embarcado.</p>
      {{/each}}
    </div>
    <p class="m616-vehicle-note">O movimento acompanha o token do veículo. Os tripulantes embarcados não podem arrastar seus tokens separadamente. Tripulantes proprietários de personagens recebem permissão de proprietário do veículo enquanto estiverem embarcados.</p>
  </section>

</form>
