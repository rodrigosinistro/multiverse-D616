<form class="{{cssClass}} npc mm-v2-npc" autocomplete="off">
  <header class="mm-v2-npc-title">
    <div class="mm-styled-field">
      <label class="mm-styled-label -align-left" for="name"><span>Codename</span></label>
      <div class="mm-styled-input"><input name="name" type="text" value="{{actor.name}}" placeholder="Codename"/></div>
    </div>
    <div class="mm-v2-npc-rank">
      <label for="system.attributes.rank.value">RANK</label>
      <input type="number" name="system.attributes.rank.value" value="{{system.attributes.rank.value}}" data-dtype="Number"/>
    </div>
  </header>

  <div class="mm-v2-npc-top">
    <section class="mm-v2-npc-identity mm-v2-card" aria-label="Retrato e recursos">
      <div class="mm-v2-npc-portrait">
        <img src="{{actor.img}}" {{#if editable}}data-edit="img"{{/if}} alt="{{actor.name}}" title="{{actor.name}}"/>
      </div>
      <div class="mm-v2-npc-resources">
        <div class="mm-v2-npc-resource">
          <div class="mm-v2-resource-heading">HEALTH <span>DR {{system.healthDamageReduction}}</span></div>
          <div class="mm-v2-numbers"><input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" aria-label="Health atual"/><span>/</span><input type="number" name="system.health.max" value="{{system.health.max}}" data-dtype="Number" aria-label="Health máximo"/></div>
        </div>
        <div class="mm-v2-npc-resource -focus">
          <div class="mm-v2-resource-heading">FOCUS <span>DR {{system.focusDamageReduction}}</span></div>
          <div class="mm-v2-numbers"><input type="number" name="system.focus.value" value="{{system.focus.value}}" data-dtype="Number" aria-label="Focus atual"/><span>/</span><input type="number" name="system.focus.max" value="{{system.focus.max}}" data-dtype="Number" aria-label="Focus máximo"/></div>
        </div>
      </div>
    </section>

    <section class="mm-v2-card mm-v2-abilities" aria-label="Atributos">
      <h3>Abilities</h3>
      <div class="mm-v2-stat-head"><span>Ability</span><span>Score</span><span>Defense</span></div>
      {{#each system.abilities as |ability key|}}
      <div class="mm-v2-stat-row">
        <div class="mm-v2-stat-name {{#if @root.editable}}rollable{{/if}}" {{#if @root.editable}}data-formula="{1d6,1dm,1d6}+@abilities.{{key}}.value" data-label="{{ability.label}}"{{/if}}>
          {{#if (eq key "mle")}}Melee{{else if (eq key "agl")}}Agility{{else if (eq key "res")}}Resilience{{else if (eq key "vig")}}Vigilance{{else if (eq key "ego")}}Ego{{else if (eq key "log")}}Logic{{/if}}
        </div>
        <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" aria-label="Atributo {{key}}"/>
        <output>{{ability.defense}}</output>
      </div>
      {{/each}}
    </section>

    <section class="mm-v2-card mm-v2-damage" aria-label="Dano">
      <h3>Damage</h3>
      <div class="mm-v2-damage-head"><span>Ability</span><span>Multiplier</span><span>Bonus</span></div>
      <div class="mm-v2-damage-row"><span>Melee</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.mle.damageMultiplier}}</strong><output>+{{system.abilities.mle.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Agility</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.agl.damageMultiplier}}</strong><output>+{{system.abilities.agl.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Ego</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.ego.damageMultiplier}}</strong><output>+{{system.abilities.ego.value}}</output></div>
      <div class="mm-v2-damage-row"><span>Logic</span><strong><img src="systems/multiverse-d616/icons/marvel-1.svg" alt="M"/> × {{system.abilities.log.damageMultiplier}}</strong><output>+{{system.abilities.log.value}}</output></div>
    </section>
  </div>

  <div class="mm-v2-npc-bottom">
    <section class="mm-styled-container mm-powers-block">
      <h3>Powers</h3>
      <div class="mm-styled-container-body">{{> "systems/multiverse-d616/templates/actor/parts/actor-powers.hbs"}}</div>
    </section>
    <section class="mm-styled-container mm-traitstags-block">
      <h3>Traits &amp; Tags</h3>
      <div class="mm-styled-container-body">
        {{> "systems/multiverse-d616/templates/actor/parts/actor-traits.hbs"}}
        {{> "systems/multiverse-d616/templates/actor/parts/actor-tags.hbs"}}
      </div>
    </section>
  </div>
</form>
