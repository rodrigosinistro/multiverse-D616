<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <div class="mm-styled-field -lg -img">
      <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
      <div class="mm-styled-input">
        <input name="name" type="text" value="{{item.name}}" placeholder="Name"/>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs mm-tabs -two" data-group="primary">
    <a class="item" data-tab="attributes">Attributes</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Attributes Tab --}}
    <div class="tab weapon-attributes" data-group="primary" data-tab="attributes">
      {{!-- As you add new fields, add them in here! --}}
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left rollable" for="system.description" data-label="description"><span>Description</span></label>
        <div class="mm-styled-input">
          <div class="mm-item-richtext" data-field="description">
              {{#if editable}}
              <div class="mm-item-richtext-actions">
                <button type="button" class="mm-item-richtext-edit" data-field="description"><i class="fas fa-pen"></i> Editar descrição</button>
              </div>
              {{/if}}
              <div class="mm-item-richtext-readonly">{{{enriched.description}}}</div>
              {{#if editable}}
              <div class="mm-item-richtext-editor" hidden>
                <div class="mm-item-richtext-editable" contenteditable="true" role="textbox" aria-label="Editar descrição" aria-multiline="true" spellcheck="true"></div>
                <div class="mm-item-richtext-buttons">
                  <button type="button" class="mm-item-save-richtext" data-field="description"><i class="fas fa-save"></i> Salvar</button>
                  <button type="button" class="mm-item-cancel-richtext" data-field="description">Cancelar</button>
                </div>
                <p class="mm-item-richtext-help">Edite o texto acima e clique em Salvar. Formatação existente é mantida.</p>
              </div>
              {{/if}}
            </div>
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>equipped</span></label>
        <div class="mm-styled-input">
          <input type="checkbox" id="equipped" name="system.equipped"  {{ checked system.equipped }}>
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left rollable" for="system.range" data-label="range"><span>Range</span></label>
        <div class="mm-styled-input">
          <input type="text" name="system.range" value="{{system.range}}" data-dtype="String"/>
        </div>
      </div>
      {{!-- As you add new fields, add them in here! --}}
      <div class="flexcol gap-sm">
        <div class="mm-styled-field -fill">
          <label class="mm-styled-label -align-left"><span>Roll Formula</span></label>
          <div class="mm-styled-input">
            <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
          </div>
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>Damage Multiplier Bonus</span></label>
        <div class="mm-styled-input">
          <input type="text" name="system.damageMultiplierBonus" value="{{system.damageMultiplierBonus}}" data-dtype="String"/>
        </div>
      </div>
      <div class="mm-styled-field -sm">
        <label class="mm-styled-label -align-left"><span>Ability</span></label>
        <div class="mm-styled-input">
          <select name="system.ability">
            {{selectOptions abilities selected=system.ability labelAttr="label" blank=""}}
          </select>
        </div>
      </div>
      <div class="mm-styled-field -sm">
        <label class="mm-styled-label -align-left"><span>VS Defense</span></label>
        <div class="mm-styled-input">
          <select name="system.attackTarget">
            {{selectOptions abilities selected=system.attackTarget labelAttr="label" blank=""}}
          </select>
        </div>
      </div>
      <div class="mm-styled-field -sm">
        <label class="mm-styled-label -align-left"><span>Attack Kind</span></label>
        <div class="mm-styled-input">
          <select name="system.attackKind">
            {{selectOptions attackKinds selected=system.attackKind labelAttr="label" blank=""}}
          </select>
        </div>
      </div>
      <div class="mm-styled-field -sm">
        <label class="mm-styled-label -align-left"><span>Damage Type</span></label>
        <div class="mm-styled-input">
          <select name="system.damageType">
            {{selectOptions damageTypes selected=system.damageType labelAttr="label" blank=""}}
          </select>
        </div>
      </div>
    </div>
    <div class="tab weapon-effects" data-group="primary" data-tab="effects">
        {{> "systems/multiverse-d616/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>

</form>
{{log system}}
