<section class="mm-attached-powers">
  <div class="mm-attached-powers-dropzone" aria-label="Arraste um poder para associar a este equipamento">
    <i class="fas fa-hand-sparkles" aria-hidden="true"></i>
    <strong>PODERES DO EQUIPAMENTO</strong>
    <p>Arraste um PODER da ficha, da lista de Itens ou de um compêndio para esta janela para associá-lo. O poder original não será removido.</p>
  </div>
  {{#if attachedPowers.length}}
    <ul class="mm-attached-powers-list">
      {{#each attachedPowers}}
        <li class="mm-attached-power" data-attached-power-id="{{this.id}}">
          <img src="{{this.img}}" alt="" width="30" height="30" />
          <span class="mm-attached-power-name" title="{{this.data.name}}">{{this.name}}</span>
          {{#if ../canActivateAttachedPowers}}
            <button type="button" class="mm-attached-power-use" title="Usar poder com este personagem"><i class="fas fa-bolt"></i> Usar</button>
          {{/if}}
          {{#if ../editable}}
            <button type="button" class="mm-attached-power-edit" title="Editar a cópia deste poder (inclusive seu elemento)"><i class="fas fa-pen"></i></button>
            <button type="button" class="mm-attached-power-remove" title="Remover associação (não apaga o poder original)"><i class="fas fa-trash"></i></button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
    {{#if attachedPowersUnequipped}}
      <p class="mm-attached-power-info">Equipe esta arma no personagem para usar seus poderes associados.</p>
    {{/if}}
    {{#unless canActivateAttachedPowers}}
      {{#unless attachedPowersUnequipped}}
        <p class="mm-attached-power-info">Para usar os poderes, adicione este equipamento ao inventário de um personagem.</p>
      {{/unless}}
    {{/unless}}
  {{else}}
    <p class="mm-attached-powers-empty">Nenhum poder associado.</p>
  {{/if}}
</section>
